# ---------------------------------------------------------------------------
# Jobi Search — environment template
#
# This file exists because the hosting platform protects the dot-prefixed
# `.env.example` path from edits. Copy this file to `.env` and fill it in.
#
#   cp env.example .env      # then start SearXNG: docker compose up -d
#
# `.env` is gitignored. NEVER commit real secrets.
# ---------------------------------------------------------------------------

# --- Convex -----------------------------------------------------------------
# Populated by `bunx convex dev`. Not secret, but deployment-specific.
VITE_CONVEX_URL=
CONVEX_SITE_URL=http://localhost:5173
CONVEX_DEPLOYMENT=

# --- Self-hosted SearXNG search layer ---------------------------------------
# Internal address the BACKEND uses to reach SearXNG.
#   Local dev (backend on the host):           http://localhost:8888
#   Backend + SearXNG on same Docker network:  http://searxng:8080
# Never expose this to the browser and never publish SearXNG publicly.
SEARXNG_URL=http://localhost:8888

# Optional tunables (defaults shown).
SEARCH_CACHE_TTL=900        # seconds an identical query is cached
SEARCH_TIMEOUT=10000        # per-request timeout, milliseconds
SEARXNG_MAX_RESULTS=15      # max results kept per query
SEARXNG_LANGUAGE=en
SEARXNG_CATEGORIES=general
# SEARXNG_ENGINES=google,duckduckgo,bing   # optional engine restriction

# Instance secret for the SearXNG container. Change for production.
SEARXNG_SECRET_KEY=

# --- Optional second search source ------------------------------------------
# Google Search grounding through Gemini. Leave empty to run on SearXNG alone
# (nothing else changes). The key is read server-side only and never returned
# to the browser.
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash

# --- Hotel extraction backend (Python FastAPI) ---------------------------
# Base URL of the extraction service (backend/extractor/main.py).
# The Convex backend calls this from an internalAction, so the URL is never
# exposed to the browser.
#
# Local dev (backend on host, extractor on host):
#   BACKEND_EXTRACTOR_URL=http://localhost:8010
# Same Docker network (backend + extractor in containers):
#   BACKEND_EXTRACTOR_URL=http://extractor:8010
#
# When unset, the extraction stage is skipped and the pipeline runs on
# search-result snippets only (offers stay OBSERVED, never VERIFIED).
# BACKEND_EXTRACTOR_URL=
# EXTRACTION_TIMEOUT_MS=20000         # per-batch extraction timeout
# EXTRACTION_MAX_URLS_PER_BATCH=30    # max URLs sent to extractor per search

# --- Development helpers ----------------------------------------------------
# Ad slots (frontend). Keep false until you connect a real ad network.
VITE_ADS_ENABLED=false

# Force the mock research provider even when SEARXNG_URL is configured.
# JOBI_FORCE_DEMO=0
